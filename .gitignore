# LaTeX build artifacts
*.aux
*.log
*.out
*.dvi
*.synctex.gz

# Intermediate images inside the figure sources. The .tex stays tracked;
# the compiled SVGs in figures/build/ are the ones the pages actually load.
figures/src/**/*.pdf
figures/src/**/*.png

